 {
  "type": "Section",
  "key": "k101",
  "label": "CLOSEOUT VALIDATION",
  "data_name": "closeout_validation",
  "required": false,
  "disabled": false,
  "hidden": false,
  "display": "inline",
  "description": "The eight checks the brief requires before CLOSED - unapproved production, failed QA, open corrections, remaining planned work, material discrepancies, missing documentation, unresolved change orders, missing test results - all need other records, which this record cannot see. They are computed by reports/closeout-readiness.sql. What this section does is make somebody state, on the record, that they ran it.",
  "elements": [
   {
    "type": "YesNoField",
    "key": "k040",
    "label": "Readiness Report Reviewed",
    "data_name": "readiness_reviewed",
    "required": false,
    "disabled": false,
    "hidden": false,
    "neutral_enabled": false,
    "positive": {
     "label": "Yes",
     "value": "yes"
    },
    "negative": {
     "label": "No",
     "value": "no"
    },
    "description": "Set to Yes once reports/closeout-readiness.sql has been run for this project and its findings read. Required before CLOSED."
   },
   {
    "type": "DateTimeField",
    "key": "k041",
    "label": "Readiness Reviewed Date",
    "data_name": "readiness_reviewed_date",
    "required": false,
    "disabled": true,
    "hidden": false,
    "description": "Stamped automatically when the readiness report is marked reviewed, and cleared if that is unset."
   },
   {
    "type": "TextField",
    "key": "k042",
    "label": "Readiness Reviewed By",
    "data_name": "readiness_reviewed_by",
    "required": false,
    "disabled": true,
    "hidden": false
   },
   {
    "type": "TextField",
    "key": "k043",
    "label": "Open Blockers Noted",
    "data_name": "open_blockers_noted",
    "required": false,
    "disabled": false,
    "hidden": false,
    "description": "What the readiness report still showed at the time of review. Left blank when it came back clean."
   }
  ]
 },
 {
