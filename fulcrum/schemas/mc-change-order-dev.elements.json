[
 {"type":"TextField","key":"o001","label":"Change Order Number","data_name":"change_order_number","description":"As it appears on the contract document. Assigned by the contract administrator, not by this app - the paperwork is the source of truth for the number.","required":true,"disabled":false,"hidden":false},
 {"type":"TextField","key":"o002","label":"Change Order Record ID","data_name":"change_order_record_id","description":"System-assigned once, never regenerated. Distinct from the contract number so two people entering the same paperwork twice is detectable.","required":false,"disabled":true,"hidden":false},
 {"type":"Section","key":"o100","label":"CHANGE ORDER","data_name":"change_order","required":false,"disabled":false,"hidden":false,"display":"inline","elements":[
  {"type":"RecordLinkField","key":"o003","label":"Project","data_name":"project_link","required":true,"disabled":false,"hidden":false,"form_id":"5ce243d4-9ec1-4fbd-8659-7be9f632b55c","record_defaults":[{"destination_field_key":"o004","source_field_key":"p001"},{"destination_field_key":"o005","source_field_key":"p002"}],"allow_existing_records":true},
  {"type":"TextField","key":"o004","label":"Project ID (snapshot)","data_name":"project_id_snap","required":false,"disabled":true,"hidden":false},
  {"type":"TextField","key":"o005","label":"Project Name (snapshot)","data_name":"project_name_snap","required":false,"disabled":true,"hidden":false},
  {"type":"RecordLinkField","key":"o006","label":"Contractor","data_name":"contractor_link","required":false,"disabled":false,"hidden":false,"form_id":"d8a368b5-1e19-4f5f-8cf9-ff8fbdd03ab4","record_defaults":[{"destination_field_key":"o007","source_field_key":"c001"}],"allow_existing_records":true},
  {"type":"TextField","key":"o007","label":"Contractor ID (snapshot)","data_name":"contractor_id_snap","required":false,"disabled":true,"hidden":false},
  {"type":"TextField","key":"o008","label":"Description","data_name":"description","description":"What is changing and where. This is what a reviewer reads first.","required":true,"disabled":false,"hidden":false},
  {"type":"ChoiceField","key":"o009","label":"Reason","data_name":"reason","description":"Why the scope changed. Reporting on this is how repeat causes get found.","required":true,"disabled":false,"hidden":false,"choices":[{"label":"Design Change","value":"Design Change"},{"label":"Field Condition","value":"Field Condition"},{"label":"Utility Conflict","value":"Utility Conflict"},{"label":"Rock / Subsurface","value":"Rock"},{"label":"Permit or Authority Requirement","value":"Permit"},{"label":"Railroad or DOT Requirement","value":"Railroad-DOT"},{"label":"Owner Request","value":"Owner Request"},{"label":"Design Error or Omission","value":"Error-Omission"},{"label":"Weather / Force Majeure","value":"Weather"},{"label":"Quantity Reconciliation","value":"Quantity Reconciliation"},{"label":"Other","value":"Other"}]},
  {"type":"DateTimeField","key":"o010","label":"Date Submitted","data_name":"date_submitted","required":false,"disabled":true,"hidden":false},
  {"type":"TextField","key":"o011","label":"Submitted By","data_name":"submitted_by","required":false,"disabled":true,"hidden":false},
  {"type":"DateTimeField","key":"o012","label":"Date Approved","data_name":"date_approved","description":"Stamped on approval. This is the date the authorized scope moved - reports use it to reconstruct the scope as at any past date.","required":false,"disabled":true,"hidden":false},
  {"type":"TextField","key":"o013","label":"Approved By","data_name":"approved_by","required":false,"disabled":true,"hidden":false},
  {"type":"TextField","key":"o014","label":"Rejection / Cancellation Reason","data_name":"rejection_reason","description":"Required when the order is rejected or cancelled - a dead change order with no stated reason is unauditable.","required":false,"disabled":false,"hidden":false}
 ]},
 {"type":"Section","key":"o101","label":"QUANTITY CHANGES","data_name":"quantity_changes_section","required":false,"disabled":false,"hidden":false,"display":"inline","elements":[
  {"type":"Repeatable","key":"o102","label":"Quantity Change","data_name":"quantity_changes","description":"One line per affected labor code. A negative quantity is a descope and is expected. Lines lock once the order is approved.","required":false,"disabled":false,"hidden":false,"elements":[
   {"type":"ChoiceField","key":"o015","label":"Labor Code","data_name":"line_labor_code","required":true,"disabled":false,"hidden":false,"choice_list_id":"ddccba3b-c5b6-4a38-8892-805e916afacd"},
   {"type":"ChoiceField","key":"o016","label":"Unit","data_name":"line_unit","description":"Derived from the Labor Code.","required":false,"disabled":true,"hidden":false,"choice_list_id":"8713e0c3-3b5e-40a5-9886-3e5b979b7461"},
   {"type":"TextField","key":"o017","label":"Quantity Change","data_name":"line_quantity_change","description":"Signed. +2000 adds scope, -500 removes it. Never enter an absolute revised quantity - the baseline plus this delta is what makes the change reconstructable.","required":true,"disabled":false,"hidden":false,"numeric":true,"format":"decimal"},
   {"type":"TextField","key":"o018","label":"Rate","data_name":"line_rate","description":"The contract rate this line is priced at, from the rate sheet for this labor code. Entered here rather than linked so the approved order keeps the price it was approved at.","required":false,"disabled":false,"hidden":false,"min":0,"numeric":true,"format":"decimal"},
   {"type":"CalculatedField","key":"o019","label":"Line Value","data_name":"line_value","description":"Quantity Change x Rate. Negative for a descope.","required":false,"disabled":false,"hidden":false,"expression":"ROUND(COALESCE(NUM($line_quantity_change),0) * COALESCE(NUM($line_rate),0), 2)","display":{"currency":"USD","style":"currency"}},
   {"type":"TextField","key":"o020","label":"Line Notes","data_name":"line_notes","required":false,"disabled":false,"hidden":false}
  ]},
  {"type":"CalculatedField","key":"o021","label":"Change Order Value","data_name":"change_order_value","description":"Summed from the lines, never typed. A hand-entered total is the first thing to drift out of step with the detail it claims to summarise.","required":false,"disabled":false,"hidden":false,"expression":"ROUND(REPEATABLESUM($quantity_changes, COALESCE(NUM($line_quantity_change),0) * COALESCE(NUM($line_rate),0)), 2)","display":{"currency":"USD","style":"currency"}},
  {"type":"CalculatedField","key":"o022","label":"Line Count","data_name":"line_count","required":false,"disabled":false,"hidden":false,"expression":"REPEATABLECOUNT($quantity_changes)","display":{"currency":null,"style":"number"}}
 ]},
 {"type":"Section","key":"o103","label":"SUPPORTING","data_name":"supporting","required":false,"disabled":false,"hidden":false,"display":"inline","elements":[
  {"type":"PhotoField","key":"o023","label":"Attachments","data_name":"attachments","description":"Photographs and scans of the signed order, field sketches and markups.","required":false,"disabled":false,"hidden":false,"annotations_enabled":true,"timestamp_enabled":true},
  {"type":"TextField","key":"o024","label":"Notes","data_name":"notes","required":false,"disabled":false,"hidden":false},
  {"type":"SignatureField","key":"o025","label":"Approval Signature","data_name":"approval_signature","required":false,"disabled":false,"hidden":false},
  {"type":"TextField","key":"o026","label":"Exceptions (auto)","data_name":"exception_flags","description":"Auto-populated by validation. Warnings never block a save.","required":false,"disabled":true,"hidden":false},
  {"type":"ChoiceField","key":"o027","label":"Exception Severity","data_name":"exception_severity","required":false,"disabled":true,"hidden":false,"choices":[{"label":"INFO","value":"INFO"},{"label":"WARNING","value":"WARNING"},{"label":"CRITICAL","value":"CRITICAL"}]}
 ]}
