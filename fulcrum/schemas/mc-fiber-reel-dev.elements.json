 {
  "type": "Section",
  "key": "f101",
  "label": "PRINTED SEQUENTIAL RANGE",
  "data_name": "printed_sequential_range",
  "required": false,
  "disabled": false,
  "hidden": false,
  "display": "inline",
  "description": "What is printed on the cable jacket. This is the reference every production sequential is validated against.",
  "elements": [
   {
    "type": "TextField",
    "key": "f005",
    "label": "Beginning Sequential",
    "data_name": "beginning_sequential",
    "required": true,
    "disabled": false,
    "hidden": false,
    "numeric": true,
    "format": "integer",
    "min": 0
   },
   {
    "type": "TextField",
    "key": "f006",
    "label": "Ending Sequential",
    "data_name": "ending_sequential",
    "required": true,
    "disabled": false,
    "hidden": false,
    "numeric": true,
    "format": "integer",
    "min": 0
   },
   {
    "type": "CalculatedField",
    "key": "f007",
    "label": "Original Reel Footage",
    "data_name": "original_reel_footage",
    "required": false,
    "disabled": false,
    "hidden": false,
    "expression": "IF(OR(ISBLANK($beginning_sequential), ISBLANK($ending_sequential)), '', ABS(NUM($ending_sequential) - NUM($beginning_sequential)))",
    "display": {"currency": null, "style": "number"},
    "description": "ABS(End - Beginning). Direction-independent, like production sequentials."
   }
  ]
 },
 {
  "type": "Section",
  "key": "f102",
  "label": "CONSUMPTION",
  "data_name": "consumption",
  "required": false,
  "disabled": false,
  "hidden": false,
  "display": "inline",
  "description": "SPRINT 17: consumed footage, slack and remaining footage are NOT stored here. They are sums over production records, which this record cannot see, and storing a running total would break the rule that totals are never stored. Run reports/reel-balance.sql for the five separate figures: printed sequential consumed, physical installed footage, slack, waste and estimated remaining. Only waste lives here, because it is a fact about the reel that no production record carries.",
  "elements": [
   {
    "type": "TextField",
    "key": "f010",
    "label": "Waste Recorded",
    "data_name": "waste_recorded",
    "required": false,
    "disabled": false,
    "hidden": false,
    "numeric": true,
    "format": "decimal",
    "min": 0,
    "description": "Cumulative cable lost to handling, damage or cut-back. Off the reel and installed nowhere, so it is the one figure subtracted separately from the printed range. Slack is NOT waste: it is installed, inside the consumed sequential range."
   }
  ]
 },
 {
  "type": "TextField",
  "key": "f012",
  "label": "Notes",
  "data_name": "notes",
  "required": false,
  "disabled": false,
  "hidden": false
 }
]
