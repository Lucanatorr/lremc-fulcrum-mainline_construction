  "key": "z001",
  "label": "Segment ID",
  "data_name": "segment_id",
  "description": "DERIVED and direction-normalized from the two structure IDs, sorted. HH-001 -> HH-002 and HH-002 -> HH-001 both produce HH-001_HH-002, so one physical path has exactly one identity.",
  "required": false,
  "disabled": true,
  "hidden": false
 },
 {
  "type": "ChoiceField",
  "key": "z010",
  "label": "Segment Type",
  "data_name": "segment_type",
  "description": "What runs between the two structures. One physical path can carry several types, each as its own segment record - conduit and the fiber inside it are different things with different lengths and different pay units.",
  "required": true,
  "disabled": false,
  "hidden": false,
  "choices": [
