   {
    "type": "TextField",
    "key": "z013",
    "label": "Design Length (ft)",
    "data_name": "design_length",
    "description": "From the design drawing. Kept separate from the as-built length so the two stay independently auditable.",
    "required": false,
    "disabled": false,
    "hidden": false,
    "min": 0,
    "numeric": true,
    "format": "decimal"
   },
   {
    "type": "TextField",
    "key": "z014",
    "label": "As-Built Length (ft)",
    "data_name": "as_built_length",
    "description": "What was actually placed. This is NOT the production quantity - production is recorded per transaction against a pay unit, and one segment can take several transactions.",
    "required": false,
    "disabled": false,
    "hidden": false,
    "min": 0,
    "numeric": true,
    "format": "decimal"
   },
   {
    "type": "CalculatedField",
    "key": "z015",
    "label": "Length Variance (ft)",
    "data_name": "length_variance",
    "description": "As-built minus design. Positive means the run was longer than drawn, which is where change-order conversations start.",
    "required": false,
    "disabled": false,
    "hidden": false,
    "expression": "IF(OR(ISBLANK($design_length), ISBLANK($as_built_length)), '', ROUND(NUM($as_built_length) - NUM($design_length), 2))",
    "display": {
     "currency": null,
     "style": "number"
    }
   },
   {
    "type": "TextField",
    "key": "z021",
